# Copy to .env (gitignored) and fill in. Used by scripts/bootstrap_tokens.sh
# and scripts/deploy_dashboard.sh. Both "KEY=value" and "KEY: value" work.

# Netatmo app (dev.netatmo.com -> My apps)
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
# From the app's Token generator, scopes read_thermostat write_thermostat read_station
REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS
AWS_PROFILE=your-aws-profile
REGION=eu-central-1
STACK_NAME=netatmo-trv-compensator
PARAMETER_PREFIX=/netatmo-trv
